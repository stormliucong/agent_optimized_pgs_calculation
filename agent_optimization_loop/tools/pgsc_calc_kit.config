// Extra Nextflow config for the reference run (tools/make_reference.sh).
// None of it changes how pgsc_calc matches variants.

process {
    // 1. No mean imputation: a missing genotype contributes nothing.
    //    (pgsc_calc otherwise imputes from cohort allele frequencies once a
    //    sampleset has >= 50 samples; this benchmark has 100.)
    withName: 'PLINK2_SCORE' {
        ext.args2 = "zs no-mean-imputation"
    }

    // 2. --only_score skips the HTML report, which is the only thing that
    //    normally copies the aggregated scores out of the work directory.
    withName: 'SCORE_AGGREGATE' {
        publishDir = [
            path: { "${params.outdir}/${task.tag.tokenize(' ')[0]}/score" },
            pattern: '*.txt.gz',
            mode: 'copy'
        ]
    }
}

// 3. Use the whole machine. The stock config pins the heavy stages to 2 CPUs,
//    and --max_cpus alone is only a ceiling. This changes wall clock only.
process {
    withLabel: process_medium      { cpus = { params.max_cpus as int } }
    withLabel: process_high_memory { cpus = { params.max_cpus as int } }
    withLabel: process_low         { cpus = { Math.max(1, (params.max_cpus as int).intdiv(2)) } }
}

// Platform overrides (PGSC_PLINK2_ENV / PGSC_UTILS_ENV) are written by
// tools/make_reference.sh into .pgsc_calc/overrides.config when those
// variables are set. Newer Nextflow config syntax does not allow `if` here.
